# ---------------------------------------------------------------------------
# REQUIRED for any build (dev / preview / production)
# ---------------------------------------------------------------------------
# Backend that proxies Photon, Google Places and OpenAI requests
ACHETUT_BACK_URL=https://achetut-back.time2map.com

# Google Maps SDK key (Android + iOS).
# In Google Cloud Console restrict it to:
#   - Android app, package: com.time2map.achetut, with the release SHA-1 fingerprint
#   - iOS app, bundle id:    com.time2map.achetut
# Required APIs to enable on the key:
#   - Maps SDK for Android
#   - Maps SDK for iOS
GOOGLE_MAPS_API_KEY=your_google_maps_sdk_key

# ---------------------------------------------------------------------------
# OPTIONAL — admin-only, MUST be empty in production builds
# ---------------------------------------------------------------------------
# Admin token used by the backend for privileged operations (model picker, etc.)
# Leave empty / unset for any build that ships to Google Play / App Store.
X_USER_ID=

# Used only by the legacy web preview, not by the mobile app
GOOGLE_MAPS_MAP_ID=DEMO_MAP
GPT_API_KEY=

# CI marker (set automatically by GitLab/EAS); usually no need to touch
CI=1
